<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <UnoCrmProjectDir>..\..\Uno_CRM</UnoCrmProjectDir>
    <BuildUnoCrmOnPublish Condition="'$(BuildUnoCrmOnPublish)' == ''">false</BuildUnoCrmOnPublish>
    <BuildUnoCrmOnBuild Condition="'$(BuildUnoCrmOnBuild)' == ''">true</BuildUnoCrmOnBuild>
    <ExcludeWwwrootFromPublish Condition="'$(ExcludeWwwrootFromPublish)' == ''">false</ExcludeWwwrootFromPublish>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DbFixer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="ClientApp\**" />
    <Content Remove="publish_test\**" />
    <Content Remove="publish_test3\**" />
    <Content Remove="publish_test4\**" />
    <Content Remove="preprocessed.xml" />
    <Content Remove="*.csx" />
    <Content Remove="*.py" />
    <Content Remove="scratch_*.csv" />
    <Content Remove="*.bak" />
    <None Remove="ClientApp\**" />
    <None Remove="publish_test\**" />
    <None Remove="publish_test3\**" />
    <None Remove="publish_test4\**" />
    <None Remove="preprocessed.xml" />
    <None Remove="*.csx" />
    <None Remove="*.py" />
    <None Remove="scratch_*.csv" />
    <None Remove="*.bak" />
  </ItemGroup>

  <ItemGroup Condition="'$(ExcludeWwwrootFromPublish)' == 'true'">
    <Content Update="wwwroot\**">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="StopUnoApiProcessesBeforeBuild" BeforeTargets="Build;Publish" Condition="'$(OS)' == 'Windows_NT' and Exists('$(MSBuildProjectDirectory)\..\stop-uno-api.ps1')">
    <Message Text="Stopping local Uno_API processes before build/publish..." Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\stop-uno-api.ps1&quot; -Quiet -Aggressive" IgnoreExitCode="true" />
  </Target>

  <PropertyGroup>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <Target Name="BuildUnoCrmTarget" BeforeTargets="ComputeFilesToPublish" Condition="'$(UnoCrmHasBuilt)' != 'true' and Exists('$(UnoCrmProjectDir)\package.json')">
    <Message Text="Building Uno_CRM SPA for Uno_API..." Importance="high" />
    <Exec WorkingDirectory="$(UnoCrmProjectDir)" Command="npm.cmd run build" EnvironmentVariables="NEXT_BUILD=true" />
    
    <RemoveDir Directories="wwwroot" />
    <MakeDir Directories="wwwroot" />
    <!-- Copy exported Next.js app to wwwroot -->
    <Exec Command="xcopy /Y /E /I &quot;$(UnoCrmProjectDir)\out\*&quot; &quot;wwwroot\&quot;" />
    
    <PropertyGroup>
      <UnoCrmHasBuilt>true</UnoCrmHasBuilt>
    </PropertyGroup>

    <ItemGroup>
      <!-- Force MSBuild to recognize the newly generated files and push them to the WebDeploy payload -->
      <Content Remove="wwwroot\**" />
      <Content Remove="wwwroot\**\*" />
      <Content Include="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
